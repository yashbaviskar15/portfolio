# ============================================================
# Yash Baviskar Portfolio — Environment Variable Template
# Copy this file to `.env.local` (development) or configure
# these variables on your deployment host. Do NOT commit real
# keys to git. `/.env*` is gitignored EXCEPT `!.env.example`.
# ============================================================

# ------------------------------------------------------------
# GitHub REST API — Optional but strongly recommended
# ------------------------------------------------------------
# Without a token, the anonymous GitHub API rate limit is
# 60 requests per IP per hour, which is fine for a personal
# portfolio with low traffic but will be exceeded in bursts.
# Create a PAT at https://github.com/settings/tokens with:
#   - Classic token, scope: `public_repo` only, no expiry OK
#   - OR Fine-grained, Metadata read-only + Contents read-only
#   on: `yashbaviskar15/3-tier-app`, `cloud-monitoring`,
#        `cicd-pipeline`, `acos` (optional).
# Vite automatically exposes VITE_* variables to the client.
VITE_GITHUB_TOKEN=

# ------------------------------------------------------------
# Resend — Contact form backend (SERVER-SIDE ONLY)
# ------------------------------------------------------------
# Sign up at https://resend.com and create an API key.
# The client bundle NEVER sees these values; only the
# `/api/contact` server route reads them at runtime.
RESEND_API_KEY=

# Verified sending address in Resend (must be added + verified
# in the Resend dashboard first). Format: "Name <email>" or
# just the bare email.
VITE_RESEND_FROM_EMAIL="Yash Baviskar Portfolio <portfolio@yashbaviskar.me>"

# Destination inbox for incoming contact-form submissions.
# User-confirmed canonical: yashbaviskar0215@outlook.com
RESEND_TO_EMAIL=yashbaviskar0215@outlook.com
